# Copy to terraform.tfvars (gitignored). The API tokens themselves go in
# the environment, not here: CLOUDFLARE_API_TOKEN and GITHUB_TOKEN.

cloudflare_account_id = "your-account-id"
workers_subdomain     = "your-subdomain"   # <script>.<this>.workers.dev
github_owner          = "hifi-phil"
github_repo           = "your-test-repo"   # where the real loops run (ready-for-ai, …)
# Shadow: read-only Issues, Pull requests, Metadata (fine-grained tokens have
# no Checks permission). Enforce: Issues + Pull requests read AND write.
github_read_token     = "github_pat_…"   # fallback only; the Worker uses the App below

# The Worker's GitHub App (worker/README.md, known gaps): its ID, and the
# private key GitHub downloads, pasted as-is.
github_app_id          = "123456"
github_app_private_key = <<-EOT
  -----BEGIN RSA PRIVATE KEY-----
  …
  -----END RSA PRIVATE KEY-----
EOT

# mode = "shadow"      # the default; "enforce" = the Worker dispatches the repo.
#                      # Then delete the repo's loop-dispatch caller workflow.
# watchdog = "shadow"  # only honoured under mode = "enforce"

# Leave commented for the first apply; once the Worker exists, set it to
# what `tofu output migration_tag` shows ("v2" for a fresh deploy).
# deployed_do_migration_tag = "v2"

# Needed for mode = "enforce" (shadow never fires). Same Fire URL + token as
# the repo's LOOP_DISPATCH_FIRE_URL / LOOP_DISPATCH_TOKEN.
# repo_routines = {
#   "hifi-phil/umbraco-mcp-ops" = { fire_url = "https://…", token = "…" }
# }

# The e2e sandbox (docs/agent-orchestration/14-e2e-testing.md). Build the
# stub first: cd ../../e2e && npm install && npm run build. The sandbox's
# Fire URL entry is added for you, pointing at the stub.
# e2e_repo              = "mcp-ops-e2e-testing"
# e2e_stub_github_token = "github_pat_…"  # sandbox only: Contents, Issues, Pull requests read/write
