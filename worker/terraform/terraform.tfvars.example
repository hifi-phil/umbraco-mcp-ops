# Copy to terraform.tfvars (gitignored). The API tokens themselves go in
# the environment, not here: CLOUDFLARE_API_TOKEN and GITHUB_TOKEN.

cloudflare_account_id = "your-account-id"
workers_subdomain     = "your-subdomain"   # <script>.<this>.workers.dev
github_owner          = "hifi-phil"
github_repo           = "your-test-repo"   # where the real loops run (ready-for-ai, …)
github_read_token     = "github_pat_…"     # read-only: Issues, Pull requests, Metadata (fine-grained tokens have no Checks permission)

# mode = "shadow"   # the default; "enforce" is Phase 4

# Leave commented for the first apply; uncomment once the Worker exists.
# deployed_do_migration_tag = "v1"
