{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types", "vitest/globals"]
  },
  "include": ["**/*.ts", "../graph/**/*.ts"],
  // The db tests run in Node: test/db/tsconfig.json checks them.
  "exclude": ["test/db/**", "node_modules", "dist"]
}
